# --- Server ---
PORT=5001
NODE_ENV=development
CLIENT_URLS=http://localhost:5173
# CLIENT_URL=http://localhost:5173   # legacy fallback

# --- Database (Neon). Locally use the `dev` branch ---
DATABASE_URI=
TEST_DATABASE_URI=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (production: Brevo HTTPS API) ---
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Campus Connect

# --- Email (local only, optional nodemailer SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# --- Optional ---
ALLOWED_EMAIL_DOMAINS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Rate limiting (OFF unless true) ---
ENABLE_RATE_LIMIT=false

# Set true only if HTTPS calls stall ~15 s on your network (broken IPv6)
FORCE_IPV4=false
